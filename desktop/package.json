{
  "name": "oharu-desktop",
  "productName": "Oharu",
  "version": "1.7.3",
  "description": "Oharu — Today's To-Do List Widget (투두리스트 위젯)",
  "main": "main.js",
  "author": "moodweb",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.moodweb.oharu",
    "productName": "Oharu",
    "copyright": "MoodWeb",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "../web/index.html",
        "to": "web/index.html"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oharu (오하루)",
      "artifactName": "Oharu-Setup.exe",
      "uninstallDisplayName": "Oharu — To-Do Widget"
    },
    "artifactName": "Oharu.exe"
  }
}
