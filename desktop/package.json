{
  "name": "oharu-desktop",
  "productName": "Oharu",
  "version": "1.8.0",
  "description": "Oharu — 오늘의 할 일",
  "main": "main.js",
  "author": "moodweb",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test test/*.test.js",
    "test:runtime": "electron test/runtime-smoke.cjs",
    "dist:signed": "electron-builder --win nsis -c.forceCodeSigning=true"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.moodweb.oharu",
    "productName": "Oharu",
    "copyright": "MoodWeb",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/**",
      "reminders.js",
      "notification-status.js",
      "security.js"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "index.html",
          "theme-system.js",
          "theme-system.css",
          "reminders.js",
          "icon-*.png",
          "manifest.json",
          "sw.js",
          "privacy.html"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oharu (오하루)",
      "artifactName": "Oharu-Setup.exe",
      "uninstallDisplayName": "Oharu — 오늘의 할 일",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "perMachine": false,
      "runAfterFinish": false
    },
    "artifactName": "Oharu.exe"
  }
}
