<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/oharu_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="16dp" android:background="@drawable/oharu_widget_background">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/oharu_widget_name" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
 <TextView android:id="@+id/oharu_widget_tasks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:text="@string/oharu_widget_empty" android:textColor="#333D4B" android:textSize="14sp" android:maxLines="7" android:ellipsize="end" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/oharu_widget_open" android:textColor="#4E5968" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
